#!/usr/bin/env python3
"""
Penny dictation daemon.

Hold Right Option (⌥) for at least HOLD_THRESHOLD seconds to start
recording. Release to stop and transcribe. The transcribed text is
pasted via the clipboard.

The debounce on HOLD_THRESHOLD is what lets this share Right Option
with Penny's refinement double-tap: a short press-and-release never
crosses the threshold, so the dictation pipeline ignores it and the
refinement detector gets a clean double-tap.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
import threading
import time

import numpy as np
import scipy.io.wavfile as wav
import sounddevice as sd
from pynput import keyboard

SAMPLE_RATE = 16000
HOTKEY = keyboard.Key.alt_r            # Right Option
HOLD_THRESHOLD = 0.22                  # seconds — anything shorter is not a hold
STREAM_INTERVAL = 0.9                  # seconds between live-preview passes

CONFIG_PATH = os.path.expanduser("~/.penny/config.json")
STATE_PATH = os.path.expanduser("~/.penny/dictate.state")
TRANSCRIPT_PATH = os.path.expanduser("~/.penny/dictate.transcript")


def whisper_model_from_config() -> str:
    """Read the chosen Whisper model from the user config. Falls back to
    distil-large-v3 if config is missing or malformed."""
    try:
        with open(CONFIG_PATH) as fh:
            return json.load(fh).get("whisper_model", "distil-large-v3")
    except (OSError, json.JSONDecodeError):
        return "distil-large-v3"


def _atomic_write(path: str, value: str) -> None:
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(value)
        os.replace(tmp, path)
    except OSError:
        pass


def write_state(value: str) -> None:
    """Publish the current daemon state for the Swift overlay to pick up."""
    _atomic_write(STATE_PATH, value)


def write_transcript(value: str) -> None:
    """Publish the latest in-progress transcript for the Swift overlay."""
    _atomic_write(TRANSCRIPT_PATH, value)


# ── State shared across threads ──────────────────────────────────────────────

recording = False
audio_chunks: list[np.ndarray] = []
press_start: float | None = None
hold_timer: threading.Timer | None = None
model = None
state_lock = threading.Lock()

# Live preview worker that runs while the user is holding the key. It
# transcribes the audio collected so far every STREAM_INTERVAL seconds and
# publishes the running text to ~/.penny/dictate.transcript so the Swift
# overlay can render it. We deliberately do not type into the user's app
# during recording — Right Option being physically held would turn every
# synthesized keystroke into an Option-combo character.
stream_stop = threading.Event()
stream_thread: threading.Thread | None = None


# ── Recording lifecycle ──────────────────────────────────────────────────────

def begin_recording() -> None:
    global recording, audio_chunks, stream_thread
    with state_lock:
        if recording:
            return
        recording = True
        audio_chunks = []
    write_transcript("")
    write_state("listening")
    print("● Recording", flush=True)

    # Start the live preview loop. It owns its own stop event so end_and_
    # transcribe can shut it down cleanly without a join from inside the
    # state lock.
    stream_stop.clear()
    stream_thread = threading.Thread(target=_streaming_loop, daemon=True)
    stream_thread.start()


def _streaming_loop() -> None:
    """Re-transcribes the in-progress recording every STREAM_INTERVAL
    seconds and writes the latest text to the transcript file. Uses a
    fast inference path (beam_size=1, no VAD pre-filter) since the goal
    is responsiveness, not maximum accuracy — the final pass on release
    uses the slower, more careful settings."""
    last_text = ""
    while not stream_stop.wait(STREAM_INTERVAL):
        with state_lock:
            if not recording:
                return
            chunks = list(audio_chunks)
        if not chunks:
            continue

        audio = np.concatenate(chunks, axis=0).flatten()
        duration = audio.size / SAMPLE_RATE
        if duration < 0.5:
            continue

        try:
            segments, _ = model.transcribe(
                audio,
                beam_size=1,
                vad_filter=False,
                without_timestamps=True,
                condition_on_previous_text=False,
            )
            text = " ".join(s.text.strip() for s in segments).strip()
        except Exception as exc:
            print(f"streaming transcribe failed: {exc}", flush=True)
            continue

        if text and text != last_text:
            last_text = text
            write_transcript(text)


def end_and_transcribe() -> None:
    global recording, audio_chunks
    # Tell the streaming loop to stop and wait briefly so it doesn't race
    # the final transcription pass for the inference engine.
    stream_stop.set()

    with state_lock:
        if not recording:
            return
        recording = False
        chunks = audio_chunks
        audio_chunks = []

    if not chunks:
        write_transcript("")
        write_state("idle")
        return

    audio = np.concatenate(chunks, axis=0).flatten()
    if audio.size / SAMPLE_RATE < 0.3:
        print("(too short, ignoring)", flush=True)
        write_transcript("")
        write_state("idle")
        return

    write_state("transcribing")
    try:
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as fh:
            tmp_path = fh.name
        try:
            wav.write(tmp_path, SAMPLE_RATE, audio)
            segments, _ = model.transcribe(tmp_path, beam_size=5, vad_filter=True)
            text = " ".join(segment.text.strip() for segment in segments).strip()
        finally:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass

        if not text:
            print("(silence)", flush=True)
            return

        print(f"→ {text}", flush=True)
        paste_text(text)
    finally:
        write_transcript("")
        write_state("idle")


def paste_text(text: str) -> None:
    """Drop the text on the clipboard and simulate ⌘V."""
    subprocess.run(["pbcopy"], input=text.encode("utf-8"), check=True)
    subprocess.run(
        [
            "osascript",
            "-e",
            'tell application "System Events" to keystroke "v" using command down',
        ],
        check=True,
    )


# ── Audio capture ────────────────────────────────────────────────────────────

def audio_callback(indata, frames, time_info, status):
    if recording:
        with state_lock:
            audio_chunks.append(indata.copy())


# ── Keyboard listener ────────────────────────────────────────────────────────

def on_press(key: keyboard.Key) -> None:
    """Right Option pressed. Start a timer; only commit to recording if the
    key is still held when the timer fires."""
    global press_start, hold_timer
    if key != HOTKEY:
        return

    with state_lock:
        # Only honour first transition; pynput repeats while held.
        if press_start is not None or recording:
            return
        press_start = time.monotonic()

        def fire() -> None:
            with state_lock:
                still_held = press_start is not None
            if still_held:
                begin_recording()

        hold_timer = threading.Timer(HOLD_THRESHOLD, fire)
        hold_timer.daemon = True
        hold_timer.start()


def on_release(key: keyboard.Key) -> None:
    """Right Option released. If we were recording, transcribe. If we never
    crossed the threshold, drop the event silently so the refinement
    daemon gets a clean tap."""
    global press_start, hold_timer
    if key != HOTKEY:
        return

    with state_lock:
        timer = hold_timer
        press_start = None
        hold_timer = None
        was_recording = recording

    if timer is not None:
        timer.cancel()

    if was_recording:
        threading.Thread(target=end_and_transcribe, daemon=True).start()


# ── Entry point ──────────────────────────────────────────────────────────────

def load_model() -> None:
    global model
    size = whisper_model_from_config()
    print(f"Loading Whisper model: {size} (first run may download)…", flush=True)
    from faster_whisper import WhisperModel
    model = WhisperModel(size, device="cpu", compute_type="int8")
    print("Penny dictation ready. Hold Right ⌥ to dictate.", flush=True)


def main() -> int:
    write_state("idle")
    load_model()
    stream = sd.InputStream(
        samplerate=SAMPLE_RATE,
        channels=1,
        dtype="float32",
        callback=audio_callback,
    )
    with stream:
        with keyboard.Listener(on_press=on_press, on_release=on_release) as listener:
            listener.join()
    return 0


if __name__ == "__main__":
    sys.exit(main())
